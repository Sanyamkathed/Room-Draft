    "react": "~19.2.8",
    "react-dom": "~19.2.8",
    "tailwind-merge": "^3.2.0",
    "three": "^0.175.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.3",
    "@types/node": "^22.14.0",
