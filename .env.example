# Where the room-analysis service lives. Leave unset and the app uses this
# default; the app works fine with nothing listening there, it just falls back
# to solving perspective in the browser.
NEXT_PUBLIC_CV_ENDPOINT=http://localhost:8000

# Pinterest (Inspo page). Leave unset and Inspo shows "almost ready" with a
# paste-a-link box; set all three to let people connect their Pinterest.
# Get the id and secret from developers.pinterest.com → My apps.
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
# Must match a redirect URI registered on the Pinterest app exactly.
PINTEREST_REDIRECT_URI=https://roomdraft.co/api/pinterest/callback
