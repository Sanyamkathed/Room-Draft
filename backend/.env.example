# Where model weights live. Point this at a drive with a few GB free --
# the default puts them under backend/.models on the system drive.
# AURA_MODEL_DIR=D:/aura-models

# Depth. The default ships safetensors and runs in ~1.5s on a laptop CPU.
# Intel/dpt-hybrid-midas is literal MiDaS 3.0 but needs torch >= 2.6.
AURA_DEPTH_MODEL=LiheYoung/depth-anything-small-hf
AURA_YOLO_WEIGHTS=yolov8n.pt

# auto | cpu | cuda
AURA_DEVICE=auto

# Set to 0 for an offline deployment: a missing checkpoint then returns a
# clear 503 instead of trying to fetch it.
AURA_ALLOW_DOWNLOAD=1
# Load both models at startup instead of on first request. Worth it: the
# first cold request is ~35s and a warm one ~2s, and without this the
# user who happens to arrive first pays the whole difference.
AURA_PRELOAD=1

AURA_MAX_SIDE=1024
AURA_MAX_UPLOAD_MB=24
AURA_CAMERA_HEIGHT=1.5
AURA_FOV_DEG=60
AURA_DETECT_CONF=0.30
AURA_CORS_ORIGINS=http://localhost:3000,http://localhost:3210
